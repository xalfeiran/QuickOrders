# Copy this file to .env and adjust as needed.

# --- Backend ---
# Port the NestJS API listens on (inside the container and on the host).
BACKEND_PORT=3000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:8080

# Secret used to sign phone-verification grants. Set a long random value in
# production — anyone with this secret can forge a verified-phone grant.
VERIFICATION_SECRET=dev-insecure-secret-change-me

# Secret used to sign admin dashboard session cookies. Set a long random value.
SESSION_SECRET=dev-insecure-session-secret

# Initial superadmin, seeded on first boot if no admin users exist.
ADMIN_EMAIL=admin@quickorder.local
ADMIN_PASSWORD=changeme

# --- Database (Postgres) ---
# Used by both the `db` container and the backend. Change here once.
DB_USER=quickorder
DB_PASSWORD=quickorder
DB_NAME=quickorder
# Host port Postgres is exposed on (handy for local tools / psql).
DB_PORT=5432
# DB host as seen by the backend. Under Docker Compose this is the service
# name "db" (set automatically in docker-compose.yml). For running the
# backend directly on your machine, use localhost.
DB_HOST=localhost

# --- Frontend ---
# Host port the nginx-served frontend is exposed on.
FRONTEND_PORT=8080

# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:3000/api
