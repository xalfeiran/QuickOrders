# Copy to .env, run `php artisan key:generate`, then fill in real secrets.

APP_NAME=QuickOrder
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL of this API (no trailing slash), e.g. https://api.your-domain.com
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (MySQL — the DB every cPanel shared-hosting plan includes) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quickorder
DB_USERNAME=quickorder
DB_PASSWORD=quickorder

# --- Sessions (admin dashboard login) ---
# 'database' needs no extra service — same reasoning as the old backend's
# Postgres-backed connect-pg-simple store, just pointed at this MySQL DB.
SESSION_DRIVER=database
SESSION_LIFETIME=10080
# 7 days, in minutes — matches the old session cookie's 7-day maxAge.
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave unset for same-site deployments. Set to a shared parent domain
# (e.g. .your-domain.com) only if the frontend and API are on different
# subdomains of the same domain.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Origins allowed to call this API (comma-separated, no trailing slash).
CORS_ORIGIN=http://localhost:5173
# Same origins, without the scheme — Sanctum uses this list to decide which
# callers get cookie-session auth instead of needing a bearer token.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Secret used to sign phone-verification grants (HMAC). Set a long random
# value in production — anyone with this secret can forge a verified-phone
# grant. Generate one with: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
VERIFICATION_SECRET=dev-insecure-secret-change-me

# Initial superadmin, created by `php artisan db:seed` if no admin users exist.
ADMIN_EMAIL=admin@quickorder.local
ADMIN_PASSWORD=changeme

# Business-admin login for the default (test) business, Alita Mía, created by
# `php artisan db:seed` if it doesn't exist yet.
BUSINESS_ADMIN_EMAIL=alita-mia@quickorder.local
BUSINESS_ADMIN_PASSWORD=changeme

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting rarely offers a queue worker process — codes are "sent"
# synchronously either way (see App\Services\MockWhatsAppNotifier).
QUEUE_CONNECTION=sync

# 'file' avoids needing a cache table or an extra service on shared hosting.
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
